# 基础设施巡检 Skill — 环境变量模板（非运行时必读文件）
#
# patrol.sh 启动时只从「当前进程的系统运行环境」读取 PATROL_* 变量，
# 不会自动 source 本文件。用法：
#   1) OpenOcta AMC / Sophon：Skill 包内 config.env 由平台在握手后注入进程环境（见 UPLOAD_FORMAT §1.3）
#   2) 本地调试：export PATROL_SERVER=... 后直接 ./scripts/patrol.sh --all
#   3) 或一次性：PATROL_SERVER=... PATROL_NETWORK=... ./scripts/patrol.sh --all
#
# 敏感值请使用 @config:ALIAS/field 引用 Config Vault，勿提交明文

# --- Linux 服务器（Config Vault：alias=PATROL「日常巡检服务器」）---
# 字段 SERVER → PATROL_SERVER（3 段即可：name|user@host:port|tags，密码走全局变量）
# 字段 PASSWORD → 注入为 PATROL_SSH_PASSWORD（脚本内亦兼容 PATROL_PASSWORD）
# 握手时 AMC 解析引用后经 config_inject_token 注入 execute 子进程
PATROL_SERVER=@config:PATROL/SERVER
PATROL_SSH_PASSWORD=@config:PATROL/PASSWORD

# 整包引用（可选，与上行等效并额外注入 OCTA_CFG_PROFILE_ALIAS / OCTA_CFG_PREFIX）：
# PATROL_VAULT=@config:PATROL


# 本地调试示例（勿提交明文）：
# PATROL_SERVER=host52|root@192.168.50.52:22|production,fenda
# PATROL_SERVER_JSON=[{"name":"host52","host":"192.168.50.52","user":"root","port":22,"tags":["production","fenda"]}]

# --- 网络设备：路由器 / 交换机 / 防火墙（二选一，JSON 优先）---
# 格式: name|type|host或user@host:port|tags|ports或snmp_community
# type: ping | ssh-cisco | ssh-huawei | ssh-h3c | ssh-generic | snmp

# PATROL_NETWORK=core-rtr|ping|192.168.1.1|network,core|22,161,443;sw-core|ssh-huawei|admin@10.0.0.2:22|network,access|
# PATROL_NETWORK_JSON=[{"name":"core-rtr","type":"ping","host":"192.168.1.254","tags":["network"],"ports":[22,443]}]

# --- Linux 告警阈值 ---

PATROL_DISK_WARN=80
PATROL_DISK_CRIT=90
PATROL_MEM_WARN=85
PATROL_MEM_CRIT=95
PATROL_LOAD_WARN=5
PATROL_LOAD_CRIT=10
PATROL_CPU_WARN=80

# --- 网络告警阈值 ---

PATROL_NET_PORTS=22,80,443,161
PATROL_PING_COUNT=3
PATROL_PING_LOSS_WARN=20
PATROL_PING_LOSS_CRIT=50
PATROL_PING_RTT_WARN=100
PATROL_PING_RTT_CRIT=500
PATROL_NET_CPU_WARN=80
PATROL_NET_MEM_WARN=85

# SNMP（可选；也可用 @config:SNMP_RO/community）
# PATROL_SNMP_COMMUNITY=@config:SNMP_RO/community
PATROL_SNMP_VERSION=2c

# --- 巡检项 ---

# PATROL_SERVICES=nginx,docker,postgresql
PATROL_SERVICES=

# --- SSH ---

# 推荐密钥；密码认证使用上方 PATROL_SSH_PASSWORD（Vault PASSWORD 字段）
PATROL_SSH_IDENTITY=~/.ssh/id_rsa
# PATROL_SSH_IDENTITY=@config:PATROL/private_key
PATROL_SSH_TIMEOUT=10
PATROL_CONCURRENCY=5

# --- 报告 ---

PATROL_REPORT_DIR=./reports
